<mvc:View controllerName="fioriapp.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="dashboard" title="{i18n>title}">
        <VBox id="vbox">
        <ObjectHeader
            id="objectCard"
            title="{i18n>Willkommen!}"
            intro="{i18n>subheader}"
            titleActive="true"
            titlePress="onObjectCardPress">
            <attributes>
                <ObjectAttribute id="description" text="{i18n>description}" />
            </attributes>
            <statuses>
                <ObjectStatus id="status" text="{i18n>status}" />
            </statuses>
        </ObjectHeader>

        <Button id="PageCurrentEventsButton"
            text="{i18n>currentEventsButton}"
            press="onShowCurrentEvents" />

        <Text id="text" text="First line&#13;&#10;Second line" />

        <Button
            id="detailButton"
            text="Details anzeigen"
            press="onShowDetails"
            icon="sap-icon://detail-view"
            type="Emphasized"
            class="sapUiMediumMarginBegin" />
        </VBox>

    </Page>
</mvc:View>