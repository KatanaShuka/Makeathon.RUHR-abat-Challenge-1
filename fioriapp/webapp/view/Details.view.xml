<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns:table="sap.m" xmlns="sap.m" controllerName="fioriapp.controller.Details">
    <Page id="details" title="{i18n>title}">
        <VBox id="details-hbox">
            <ObjectHeader
                id="details-card"
                title="Tour auswählen"
                intro="Tourdetails"/>
            <HBox
                id="hbox"
                width="100%"
                justifyContent="Center"
                alignItems="Start"
                class="sapUiLargeMarginTop">
                <Panel
                id="info"
                width="100%"
                expandable="false"
                headerText="Informations"
                class="sapUiMediumMarginEnd">

                    <VBox class="sapUiMediumMargin">

                        <Title
                            text="Tourinformationen"
                            level="H3"/>

                        <Text
                            id="detailStart"
                            text="Tour-Start: -"/>

                        <Text
                            id="detailEnd"
                            text="Tour-End: -"/>

                        <Text
                            id="detailContainer"
                            text="Container: -"/>

                        <Text
                            id="detailStatus"
                            text="Status: Nicht hinterlegt"/>

                    </VBox>

                </Panel>
                <table:Table
                    id="details-table"
                    width="100%"
                    mode="SingleSelectMaster"
                    selectionChange="onSelectionChange"
                    items="{tours>/tours}"
                    noDataText="Keine Touren gefunden."
                    class="sapUiMediumMarginBegin">
                    <table:columns>
                        <table:Column id="details-table-tour" width="16em">
                            <Text text="Tour-ID"/>
                        </table:Column>
                        <table:Column id="details-table-routestart" width="12em" visible="true">
                            <Text text="Tour-Start"/>
                        </table:Column>
                        <table:Column id="details-table-routeend" width="12em" visible="true">
                            <Text text="Tour-End"/>
                        </table:Column>
                        <table:Column id="details-table-container" width="12em" visible="true">
                            <Text text="Container"/>
                        </table:Column>
                        <table:Column id="details-table-status" width="12em" visible="true">
                            <Text text="Status"/>
                        </table:Column>
                    </table:columns>
                    <table:items>
                        <table:ColumnListItem>
                            <table:cells>
                                <Text text="{tours>id}"/>
                                <Text text="{tours>start}"/>
                                <Text text="{tours>end}"/>
                                <Text text="{tours>container}"/>
                                <Text text="{tours>status}"/>
                            </table:cells>
                        </table:ColumnListItem>
                    </table:items>
                </table:Table>
            </HBox>
        </VBox>
    </Page>
</mvc:View>